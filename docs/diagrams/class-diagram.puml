@startuml
title Онлайн киім дүкені — дерекқор диаграммасы
hide methods
hide stereotypes
skinparam linetype ortho
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam packageStyle rectangle
skinparam defaultFontName Arial
skinparam class {
    BackgroundColor #F8FAFC
    BorderColor #2563EB
    ArrowColor #334155
}
skinparam nodesep 45
skinparam ranksep 45

class Client {
  +client_id : INT <<PK>>
  --
  name : NVARCHAR(100)
  phone : NVARCHAR(20)
  email : NVARCHAR(100)
}

class CartPayment {
  +cart_payment_id : INT <<PK>>
  --
  client_id : INT <<FK>>
  total_amount : DECIMAL(10,2)
  payment_method : NVARCHAR(30)
  payment_status : NVARCHAR(30)
  created_at : DATETIME2
}

class Category {
  +category_id : INT <<PK>>
  --
  name : NVARCHAR(100)
  description : NVARCHAR(300)
}

class Product {
  +product_id : INT <<PK>>
  --
  name : NVARCHAR(100)
  description : NVARCHAR(300)
  price : DECIMAL(10,2)
  size : NVARCHAR(20)
  color : NVARCHAR(30)
  quantity : INT
  category_id : INT <<FK>>
  warehouse_id : INT <<FK>>
}

class Warehouse {
  +warehouse_id : INT <<PK>>
  --
  warehouse_name : NVARCHAR(100)
  city : NVARCHAR(50)
  address : NVARCHAR(200)
  employee_name : NVARCHAR(100)
  employee_phone : NVARCHAR(20)
}

class Staff {
  +staff_id : INT <<PK>>
  --
  name : NVARCHAR(100)
  phone : NVARCHAR(20)
  role : NVARCHAR(20)
}

class Order {
  +order_id : INT <<PK>>
  --
  client_id : INT <<FK>>
  staff_id : INT <<FK>>
  cart_payment_id : INT <<FK>>
  product_id : INT <<FK>>
  quantity : INT
  price : DECIMAL(10,2)
  total_amount : DECIMAL(10,2)
  order_date : DATETIME2
  status : NVARCHAR(30)
  address : NVARCHAR(200)
  delivery_time : DATETIME2
  qr_scanned : BIT
}

class Delivery {
  +delivery_id : INT <<PK>>
  --
  order_id : INT <<FK, UNIQUE>>
  courier_name : NVARCHAR(100)
  courier_phone : NVARCHAR(20)
  delivery_status : NVARCHAR(30)
  delivered_at : DATETIME2
}

Client "1" -- "0..*" CartPayment : төлемдері
Client "1" -- "0..*" Order : тапсырыстары
Category "1" -- "0..*" Product : санатқа жатады
Warehouse "1" -- "0..*" Product : сақтайды
Product "1" -- "0..*" Order : тапсырыс тауары
Staff "0..1" -- "0..*" Order : өңдейді
CartPayment "0..1" -- "0..*" Order : төлемі
Order "1" -- "0..1" Delivery : жеткізіледі

legend bottom
  PK — бастапқы кілт
  FK — сыртқы кілт
  1 — бір жазба
  0..* — нөл немесе бірнеше жазба
endlegend
@enduml
